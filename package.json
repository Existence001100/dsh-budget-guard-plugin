{
  "name": "dsh-budget-guard-plugin",
  "version": "0.4.8",
  "description": "Per-task CNY/token budget guard for DeepSeek Harness: paces, warns, cancels or asks, and shows recent burn after every turn; remaining steps are reported only when the model states a plan.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "prices",
    "locale",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node test/pricing.test.mjs && node test/host.test.mjs && node test/client.test.mjs && node test/regression.test.mjs && node test/bom.test.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "budget",
    "deepseek",
    "pricing",
    "deepseek-harness",
    "cost",
    "tokens",
    "plugin"
  ],
  "author": "Existence001100",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Existence001100/dsh-budget-guard-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Existence001100/dsh-budget-guard-plugin/issues"
  },
  "homepage": "https://github.com/Existence001100/dsh-budget-guard-plugin#readme"
}
