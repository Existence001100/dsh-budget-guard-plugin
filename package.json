{
  "name": "dsh-budget-guard-plugin",
  "version": "0.4.1",
  "description": "A budget guard plugin for DSH (DeepSeek Harness).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "prices",
    "locale",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "budget",
    "deepseek",
    "pricing"
  ],
  "author": "Existence001100",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Existence001100/dsh-budget-guard.git"
  },
  "bugs": {
    "url": "https://github.com/Existence001100/dsh-budget-guard/issues"
  },
  "homepage": "https://github.com/Existence001100/dsh-budget-guard#readme"
}
